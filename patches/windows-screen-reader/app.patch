+.exam-mode:not(.exam-operable) .glance-option {flex:0 1 auto;}
+.exam-mode .reader-head .glance-number {margin-left:auto;}
+.exam-mode .reader-scroll {padding:6px 11px 8px;font:16px/24px "Microsoft YaHei UI","Segoe UI",sans-serif;scrollbar-width:none;}
+.exam-mode .reader-scroll pre {font:15px/24px Consolas,monospace;}
+.exam-mode .reader-prose p {margin:0;}
+.exam-mode .reader-prose p + p {margin-top:4px;}
+.exam-mode .glance-option {white-space:normal;overflow:visible;overflow-wrap:anywhere;font-size:15px;}
+.exam-mode .reader-page {font:12px/1.4 system-ui;color:var(--text-muted);}
+.exam-mode .reader-page:empty {display:none;}
+.exam-mode .reader-measure {position:fixed;left:0;top:0;width:max-content;height:auto;max-height:none;min-width:0;max-width:none;visibility:hidden;pointer-events:none;overflow:visible;}
+.exam-mode .reader-measure .reader-scroll {flex:none;height:auto;overflow:visible;}
+.exam-mode .reader-measure .reader-head {flex:none;max-height:none;overflow:visible;}
+
+.app :is(.transcript,.session,.reader-panel),
+.app :is(.transcript,.session,.reader-panel) :where(*) {
+  -webkit-text-fill-color: color-mix(in srgb, currentColor calc(var(--text-alpha,1) * 100%), transparent);
+}
+.app.exam-mode {
+  backdrop-filter: blur(calc(18px * var(--app-alpha))) saturate(calc(1 + .1 * var(--app-alpha)));
+  border-color: color-mix(in srgb,var(--app-border) calc(var(--app-alpha) * 100%),transparent);
+  box-shadow: inset 0 1px 0 color-mix(in srgb,var(--glass-highlight) calc(var(--app-alpha) * 100%),transparent);
+}
+.exam-mode .reader-full .reader-head {
+  border-bottom-color: color-mix(in srgb,var(--border-soft) calc(var(--app-alpha) * 100%),transparent);
+}
