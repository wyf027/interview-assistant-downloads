-const roles = [{ "id": "agent", "name": "Agent 工程师", "questions": [{ "group": "项目与交付", "title": "项目介绍", "text": "请介绍一下你最近做的一个与 AI 相关的项目，讲清它解决什么问题、你负责哪些部分，以及最后做到了什么。", "source": "nowcoder" }, { "group": "项目与交付", "title": "关键技术取舍", "text": "请讲讲你在项目里做过的一项关键技术取舍，当时考虑了哪些方案，最后是怎么决定的？", "source": "binance" }, { "group": "项目与交付", "title": "故障排查", "text": "请说说你遇到过的一次比较难定位的故障，从发现问题到验证修复，你是怎么做的？", "source": "binance" }, { "group": "项目与交付", "title": "生产上线", "text": "一个 Agent 从演示走到生产，你会怎么做回归测试、灰度上线和回滚？", "source": "eval" }, { "group": "项目与交付", "title": "实时语音交互", "text": "如果要设计一个实时语音交互 Agent，你会怎么组织音频采集、语音识别、模型调用和前端反馈？", "source": "realtime" }, { "group": "架构与状态", "title": "Agent 与工作流", "text": "Agent 和普通大模型问答、固定工作流有什么区别，哪些场景才值得引入 Agent？", "source": "agents" }, { "group": "架构与状态", "title": "执行策略", "text": "边推理边调用工具和先规划再执行这两种 Agent 模式，你会怎么选，为什么？", "source": "agents" }, { "group": "架构与状态", "title": "LangGraph 状态恢复", "text": "用 LangGraph 编排一个可中断、可恢复的流程时，你会怎么设计状态和检查点？", "source": "persistence" }, { "group": "架构与状态", "title": "单 Agent 与多 Agent", "text": "什么情况下你会把单 Agent 拆成多个 Agent，怎么控制它们的协作成本和失败传播？", "source": "agents" }, { "group": "架构与状态", "title": "记忆与上下文", "text": "Agent 的短期上下文和长期记忆分别怎么设计，哪些信息值得保存，什么时候召回？", "source": "memory" }, { "group": "工具与检索", "title": "工具调用", "text": "你会怎么设计给模型调用的工具接口，怎样校验参数，并处理参数错误或工具选错？", "source": "tool-call" }, { "group": "工具与检索", "title": "MCP 接入", "text": "MCP 与直接调用业务接口有什么区别，你会怎么用 MCP 接入一个需要授权的业务工具？", "source": "mcp" }, { "group": "工具与检索", "title": "RAG 全链路", "text": "请介绍一条检索增强生成链路，从文档切分、召回和重排到生成带证据的答案，你会怎么做？", "source": "rag" }, { "group": "工具与检索", "title": "混合召回", "text": "关键词检索和向量检索各擅长什么，怎么融合两路结果，再决定要不要重排？", "source": "hybrid" }, { "group": "工具与检索", "title": "检索效果排查", "text": "如果检索增强生成系统经常给错答案，你会怎么判断问题出在召回、重排还是生成？", "source": "eval" }, { "group": "可靠性与评估", "title": "重试与幂等", "text": "如果 Agent 调用写入工具时超时，怎么安全重试，并避免重复创建订单之类的副作用？", "source": "retry" }, { "group": "可靠性与评估", "title": "幻觉和格式错误", "text": "当模型给出没有证据的结论，或者返回的结构化数据不合法时，你会怎么检测和兜底？", "source": "structured" }, { "group": "可靠性与评估", "title": "提示词注入与越权", "text": "如果外部文档里包含诱导模型越权的指令，你会怎么保护工具调用和用户数据？", "source": "safety" }, { "group": "可靠性与评估", "title": "评估与可观测性", "text": "你会怎么搭建 Agent 的离线评估和线上监控，分别用哪些指标判断任务是否真的完成？", "source": "eval" }, { "group": "可靠性与评估", "title": "延迟和成本", "text": "当 Agent 的响应变慢、调用成本变高时，你会怎么定位瓶颈，并验证优化是否有效？", "source": "agents" }] }, { "id": "fullstack", "name": "全栈工程师", "questions": [{ "group": "前端与浏览器", "title": "JavaScript 事件循环", "text": "点击一个按钮后，同步代码、Promise 回调和定时器会按什么顺序执行？大量微任务会怎样影响页面响应？", "source": "js" }, { "group": "前端与浏览器", "title": "服务端组件与客户端组件", "text": "用 Next.js 做一个商品详情页时，哪些数据在服务端获取，哪些交互留在客户端？你如何划分边界？", "source": "next" }, { "group": "前端与浏览器", "title": "跨域与登录态", "text": "前端和 API 部署到不同域名后，带登录态的请求报跨域错误。你会检查哪些请求头、响应头和 Cookie 设置？", "source": "cors" }, { "group": "前端与浏览器", "title": "更新后仍看到旧页面", "text": "发布后部分用户还读到旧资源，你如何判断问题出在浏览器、CDN 还是应用缓存？不同资源会怎么设置缓存策略？", "source": "cache-http" }, { "group": "接口与交付", "title": "提交订单防重复", "text": "网络超时后用户再次点击提交，客户端和服务端分别怎么防重复？如何返回第一次创建的订单？", "source": "http-idempotency" }, { "group": "接口与交付", "title": "搜索结果乱序", "text": "用户连续输入关键词时，较早发出的请求可能更晚返回。你如何保证界面只展示最新查询的结果？", "source": "abort" }, { "group": "接口与交付", "title": "列表接口性能", "text": "后台列表加入筛选和排序后越来越慢。你怎么定位是数据库查询、API 响应还是浏览器渲染拖慢了页面？", "source": "explain" }, { "group": "接口与交付", "title": "多节点下的缓存一致性", "text": "商品改价后，有的用户仍看到旧价格。多个应用实例共享缓存时，你如何安排数据库写入、缓存失效和回源？", "source": "cache-aside" }] }, { "id": "ai-fullstack", "name": "AI 全栈工程师", "questions": [{ "group": "AI 应用与交互", "title": "流式聊天全链路", "text": "设计一个流式 AI 聊天页面。前端如何区分正文增量、工具调用和错误？用户取消时，后端怎样中止模型请求？", "source": "stream" }, { "group": "AI 应用与交互", "title": "断线重连与消息恢复", "text": "回复生成到一半时，用户刷新了页面。你怎么恢复已收到的内容、续接生成，并处理重复事件？", "source": "resume" }, { "group": "AI 应用与交互", "title": "文档问答与引用", "text": "设计一个知识库问答功能。文档从上传到能检索要经过哪些环节？如何让用户跳转到回答引用的原文？", "source": "rag" }, { "group": "AI 应用与交互", "title": "结构化输出校验", "text": "模型要返回一份可编辑的表单。遇到缺字段、类型不符或只收到半段结构化数据时，前端和后端分别怎么处理？", "source": "structured" }, { "group": "稳定性与安全", "t